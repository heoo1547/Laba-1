<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Многофункциональный калькулятор</title>

<style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    background:#1c1c1e;
    font-family:Arial,sans-serif;
    display:flex;
    justify-content:center;
    align-items:center;
    height:100vh;
    overflow:hidden;
}

.calculator{
    width:360px;
    background:#000;
    border-radius:35px;
    padding:16px;
    box-shadow:0 15px 40px rgba(0,0,0,.5);
}

.title{
    color:white;
    text-align:center;
    font-size:18px;
    margin-bottom:12px;
    font-weight:bold;
}

.display{
    background:#111;
    border-radius:25px;
    padding:18px;
    min-height:120px;
    margin-bottom:12px;
    display:flex;
    flex-direction:column;
    justify-content:flex-end;
}

.expression{
    color:#999;
    font-size:20px;
    text-align:right;
    min-height:28px;
    word-break:break-all;
}

.result{
    color:white;
    font-size:48px;
    text-align:right;
    margin-top:8px;
    word-break:break-all;
}

select,
input{
    width:100%;
    padding:12px;
    margin-bottom:10px;
    border:none;
    border-radius:15px;
    background:#2c2c2e;
    color:white;
    font-size:16px;
}

.buttons{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:10px;
}

button{
    height:62px;
    border:none;
    border-radius:50%;
    background:#2c2c2e;
    color:white;
    font-size:26px;
    cursor:pointer;
    transition:.15s;
}

button:active{
    transform:scale(.95);
}

.operator{
    background:#ff9f0a;
}

.equal{
    background:#00aa55;
}

.clear{
    background:#5e5e62;
}

.zero{
    grid-column:span 2;
    border-radius:40px;
}

</style>
</head>

<body>

<div class="calculator">

<div class="title">
Многофункциональный калькулятор
</div>

<div class="display">
<div class="expression" id="expression"></div>
<div class="result" id="result">0</div>
</div>

<select id="operationSelect" onchange="changeOperation()">

<option value="basic">Базовый калькулятор</option>
<option value="sqrt">Квадратный корень</option>
<option value="cbrt">Кубический корень</option>
<option value="factorial">Факториал</option>
<option value="bmi">Индекс массы тела</option>
<option value="quadratic">Квадратное уравнение</option>
<option value="percent">Проценты</option>
<option value="temperature">Перевод температур</option>

</select>

<div id="dynamicInputs"></div>

<div class="buttons">

<button class="clear" onclick="clearAll()">AC</button>

<button onclick="backspace()"><</button>

<button onclick="percentBasic()">%</button>

<button class="operator" onclick="setOperator('/')">/</button>

<button onclick="appendNumber('7')">7</button>
<button onclick="appendNumber('8')">8</button>
<button onclick="appendNumber('9')">9</button>

<button class="operator" onclick="setOperator('*')">*</button>

<button onclick="appendNumber('4')">4</button>
<button onclick="appendNumber('5')">5</button>
<button onclick="appendNumber('6')">6</button>

<button class="operator" onclick="setOperator('-')">-</button>

<button onclick="appendNumber('1')">1</button>
<button onclick="appendNumber('2')">2</button>
<button onclick="appendNumber('3')">3</button>

<button class="operator" onclick="setOperator('+')">+</button>

<button class="zero" onclick="appendNumber('0')">0</button>

<button onclick="appendDot()">.</button>

<button class="equal" onclick="calculate()">=</button>

</div>

</div>

<script>

let currentInput = '0';
let previousInput = null;
let operator = null;
let waitingForOperand = false;

const resultEl = document.getElementById('result');
const expressionEl = document.getElementById('expression');

function updateDisplay(){
    resultEl.innerText = currentInput;
}

function appendNumber(number){

    if(waitingForOperand){
        currentInput = number;
        waitingForOperand = false;
    }
    else{
        if(currentInput === '0'){
            currentInput = number;
        }
        else{
            currentInput += number;
        }
    }

    updateDisplay();
}

function appendDot(){

    if(!currentInput.includes('.')){
        currentInput += '.';
    }

    updateDisplay();
}

function backspace(){

    if(currentInput.length > 1){
        currentInput = currentInput.slice(0,-1);
    }
    else{
        currentInput = '0';
    }

    updateDisplay();
}

function clearAll(){

    currentInput = '0';
    previousInput = null;
    operator = null;
    waitingForOperand = false;

    expressionEl.innerText = '';

    updateDisplay();
}

function setOperator(op){

    previousInput = parseFloat(currentInput);

    operator = op;

    waitingForOperand = true;

    expressionEl.innerText =
        previousInput + ' ' + op;
}

function calculate(){

    const mode =
        document.getElementById('operationSelect').value;

    if(mode !== 'basic'){
        calculateAdvanced(mode);
        return;
    }

    if(operator === null || previousInput === null){
        return;
    }

    const current = parseFloat(currentInput);

    let result = 0;

    switch(operator){

        case '+':
            result = previousInput + current;
            break;

        case '-':
            result = previousInput - current;
            break;

        case '*':
            result = previousInput * current;
            break;

        case '/':

            if(current === 0){

                currentInput = 'Ошибка';

                updateDisplay();

                return;
            }

            result = previousInput / current;

            break;
    }

    expressionEl.innerText =
        `${previousInput} ${operator} ${current} =`;

    currentInput =
        parseFloat(result.toFixed(10)).toString();

    previousInput = null;
    operator = null;

    updateDisplay();
}

function percentBasic(){

    currentInput =
        (parseFloat(currentInput)/100).toString();

    updateDisplay();
}

function factorial(n){

    if(n < 0){
        return 'Ошибка';
    }

    let result = 1;

    for(let i=2;i<=n;i++){
        result *= i;
    }

    return result;
}

function calculateAdvanced(mode){

    try{

        if(mode === 'sqrt'){

            const num =
                parseFloat(document.getElementById('input1').value);

            if(num < 0){
                throw 'Ошибка';
            }

            expressionEl.innerText =
                `sqrt(${num}) =`;

            currentInput =
                Math.sqrt(num).toString();
        }

        else if(mode === 'cbrt'){

            const num =
                parseFloat(document.getElementById('input1').value);

            expressionEl.innerText =
                `cbrt(${num}) =`;

            currentInput =
                Math.cbrt(num).toString();
        }

        else if(mode === 'factorial'){

            const num =
                parseInt(document.getElementById('input1').value);

            expressionEl.innerText =
                `${num}! =`;

            currentInput =
                factorial(num).toString();
        }

        else if(mode === 'bmi'){

            const weight =
                parseFloat(document.getElementById('input1').value);

            const height =
                parseFloat(document.getElementById('input2').value);

            const bmi =
                weight / (height * height);

            expressionEl.innerText =
                `BMI(${weight}, ${height}) =`;

            currentInput =
                bmi.toFixed(2);
        }

        else if(mode === 'quadratic'){

            const a =
                parseFloat(document.getElementById('input1').value);

            const b =
                parseFloat(document.getElementById('input2').value);

            const c =
                parseFloat(document.getElementById('input3').value);

            const d = b*b - 4*a*c;

            expressionEl.innerText =
                `${a}x? + ${b}x + ${c} = 0`;

            if(d < 0){

                currentInput = 'Нет корней';
            }

            else if(d === 0){

                const x =
                    (-b)/(2*a);

                currentInput =
                    `x = ${x}`;
            }

            else{

                const x1 =
                    ((-b)+Math.sqrt(d))/(2*a);

                const x2 =
                    ((-b)-Math.sqrt(d))/(2*a);

                currentInput =
                    `x1=${x1}, x2=${x2}`;
            }
        }

        else if(mode === 'percent'){

            const percent =
                parseFloat(document.getElementById('input1').value);

            const number =
                parseFloat(document.getElementById('input2').value);

            expressionEl.innerText =
                `${percent}% от ${number} =`;

            currentInput =
                ((percent/100)*number).toString();
        }

        else if(mode === 'temperature'){

            const temp =
                parseFloat(document.getElementById('input1').value);

            const type =
                document.getElementById('tempType').value;

            let result = 0;
            let action = '';

            if(type === 'cToF'){

                result = (temp*9/5)+32;

                action = `${temp}C -> F =`;
            }

            if(type === 'fToC'){

                result = (temp-32)*5/9;

                action = `${temp}F -> C =`;
            }

            if(type === 'cToK'){

                result = temp + 273.15;

                action = `${temp}C -> K =`;
            }

            if(type === 'kToC'){

                result = temp - 273.15;

                action = `${temp}K -> C =`;
            }

            expressionEl.innerText = action;

            currentInput =
                result.toFixed(2);
        }

        updateDisplay();

    }

    catch(error){

        currentInput = 'Ошибка';

        updateDisplay();
    }
}

function changeOperation(){

    const mode =
        document.getElementById('operationSelect').value;

    const container =
        document.getElementById('dynamicInputs');

    container.innerHTML = '';

    if(
        mode === 'sqrt' ||
        mode === 'cbrt' ||
        mode === 'factorial'
    ){

        container.innerHTML = `
            <input
                id="input1"
                type="number"
                placeholder="Введите число">
        `;
    }

    else if(mode === 'bmi'){

        container.innerHTML = `
            <input
                id="input1"
                type="number"
                placeholder="Вес (кг)">

            <input
                id="input2"
                type="number"
                placeholder="Рост (м)">
        `;
    }

    else if(mode === 'quadratic'){

        container.innerHTML = `
            <input
                id="input1"
                type="number"
                placeholder="Коэффициент a">

            <input
                id="input2"
                type="number"
                placeholder="Коэффициент b">

            <input
                id="input3"
                type="number"
                placeholder="Коэффициент c">
        `;
    }

    else if(mode === 'percent'){

        container.innerHTML = `
            <input
                id="input1"
                type="number"
                placeholder="Процент">

            <input
                id="input2"
                type="number"
                placeholder="Число">
        `;
    }

    else if(mode === 'temperature'){

        container.innerHTML = `

            <input
                id="input1"
                type="number"
                placeholder="Температура">

            <select id="tempType">

                <option value="cToF">
                    Цельсий -> Фаренгейт
                </option>

                <option value="fToC">
                    Фаренгейт -> Цельсий
                </option>

                <option value="cToK">
                    Цельсий -> Кельвин
                </option>

                <option value="kToC">
                    Кельвин -> Цельсий
                </option>

            </select>
        `;
    }
}

updateDisplay();

</script>

</body>
</html>
