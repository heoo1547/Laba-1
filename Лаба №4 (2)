import tkinter as tk
from tkinter import ttk, messagebox
import math
from decimal import Decimal, getcontext

# Устанавливаем точность для Decimal
getcontext().prec = 50

class CalculatorApp:
    def __init__(self, root):
        self.root = root
        self.root.title("Многофункциональный калькулятор")
        self.root.geometry("550x600")
        self.root.resizable(False, False)
        
        self.main_frame = ttk.Frame(root, padding="10")
        self.main_frame.grid(row=0, column=0, sticky=(tk.W, tk.E, tk.N, tk.S))
        
        title_label = ttk.Label(self.main_frame, text="Многофункциональный калькулятор", 
                                font=('Arial', 16, 'bold'))
        title_label.grid(row=0, column=0, columnspan=2, pady=10)
        
        ttk.Label(self.main_frame, text="Выберите операцию:").grid(row=1, column=0, sticky=tk.W, pady=5)
        self.operation_var = tk.StringVar()
        
        operations = [
            "Сложение (+)",
            "Вычитание (-)",
            "Умножение (*)",
            "Деление (/)",
            "Возведение в степень (**)",
            "Квадратный корень (√)",
            "Кубический корень (∛)",
            "Факториал числа (n!)",
            "Индекс массы тела (ИМТ)",
            "Квадратное уравнение",
            "Проценты (X% от Y)",
            "Перевод температур"
        ]
        
        self.operation_combo = ttk.Combobox(self.main_frame, textvariable=self.operation_var, 
                                           values=operations, state="readonly", width=35)
        self.operation_combo.grid(row=1, column=1, pady=5, sticky=tk.W)
        self.operation_combo.bind('<<ComboboxSelected>>', self.on_operation_change)
        
        self.input_frame = ttk.LabelFrame(self.main_frame, text="Ввод данных", padding="10")
        self.input_frame.grid(row=2, column=0, columnspan=2, sticky=(tk.W, tk.E), pady=10)
        
        self.result_frame = ttk.LabelFrame(self.main_frame, text="Результат", padding="10")
        self.result_frame.grid(row=3, column=0, columnspan=2, sticky=(tk.W, tk.E), pady=10)
        
        self.result_label = ttk.Label(self.result_frame, text="", font=('Arial', 12), wraplength=500)
        self.result_label.grid(row=0, column=0, sticky=tk.W)
        
        self.calc_button = ttk.Button(self.main_frame, text="Вычислить", command=self.calculate, width=20)
        self.calc_button.grid(row=4, column=0, columnspan=2, pady=10)
        
        self.exit_button = ttk.Button(self.main_frame, text="Выход", command=self.root.destroy, width=20)
        self.exit_button.grid(row=5, column=0, columnspan=2, pady=5)
        
        self.input_entries = {}
        self.on_operation_change()
    
    def on_operation_change(self, event=None):
        for widget in self.input_frame.winfo_children():
            widget.destroy()
        self.input_entries.clear()
        
        operation = self.operation_var.get()
        
        if operation in ["Сложение (+)", "Вычитание (-)", "Умножение (*)", "Деление (/)", "Возведение в степень (**)"]:
            self.create_input_field("Число 1:", 0)
            self.create_input_field("Число 2:", 1)
            
        elif operation in ["Квадратный корень (√)", "Кубический корень (∛)", "Факториал числа (n!)"]:
            self.create_input_field("Число:", 0)
            
        elif operation == "Индекс массы тела (ИМТ)":
            self.create_input_field("Вес (кг):", 0)
            self.create_input_field("Рост (м):", 1)
            
        elif operation == "Квадратное уравнение":
            self.create_input_field("Коэффициент a:", 0)
            self.create_input_field("Коэффициент b:", 1)
            self.create_input_field("Коэффициент c:", 2)
            
        elif operation == "Проценты (X% от Y)":
            self.create_input_field("Процент (%):", 0)
            self.create_input_field("Число:", 1)
            
        elif operation == "Перевод температур":
            ttk.Label(self.input_frame, text="Направление:").grid(row=0, column=0, sticky=tk.W, pady=5)
            self.direction_var = tk.StringVar()
            directions = ["Цельсий -> Фаренгейт", "Фаренгейт -> Цельсий", "Цельсий -> Кельвин", "Кельвин -> Цельсий"]
            direction_combo = ttk.Combobox(self.input_frame, textvariable=self.direction_var,
                                          values=directions, state="readonly", width=30)
            direction_combo.grid(row=0, column=1, pady=5, sticky=tk.W)
            direction_combo.current(0)
            self.input_entries['direction'] = direction_combo
            self.create_input_field("Температура:", 1)
    
    def create_input_field(self, label_text, row):
        ttk.Label(self.input_frame, text=label_text).grid(row=row, column=0, sticky=tk.W, pady=5)
        entry = ttk.Entry(self.input_frame, width=30)
        entry.grid(row=row, column=1, pady=5, sticky=tk.W)
        self.input_entries[label_text] = entry
    
    def get_input_values(self):
        values = []
        for label, entry in self.input_entries.items():
            if label != 'direction':
                text = entry.get().strip()
                if not text:
                    raise ValueError(f"Поле '{label}' не заполнено")
                try:
                    # Используем Decimal для точных вычислений
                    values.append(Decimal(text))
                except:
                    try:
                        values.append(float(text))
                    except ValueError:
                        raise ValueError(f"'{text}' не является числом")
        return values
    
    def calculate(self):
        try:
            operation = self.operation_var.get()
            if not operation:
                messagebox.showwarning("Предупреждение", "Пожалуйста, выберите операцию")
                return
            
            values = self.get_input_values()
            result = ""
            
            if operation == "Сложение (+)":
                # Точное сложение
                v1 = float(values[0])
                v2 = float(values[1])
                res = v1 + v2
                # Форматируем результат
                if res.is_integer():
                    result = f"{self.format_number(v1)} + {self.format_number(v2)} = {int(res)}"
                else:
                    result = f"{self.format_number(v1)} + {self.format_number(v2)} = {res:.10f}".rstrip('0').rstrip('.')
                
            elif operation == "Вычитание (-)":
                v1 = float(values[0])
                v2 = float(values[1])
                res = v1 - v2
                if res.is_integer():
                    result = f"{self.format_number(v1)} - {self.format_number(v2)} = {int(res)}"
                else:
                    result = f"{self.format_number(v1)} - {self.format_number(v2)} = {res:.10f}".rstrip('0').rstrip('.')
                
            elif operation == "Умножение (*)":
                v1 = float(values[0])
                v2 = float(values[1])
                res = v1 * v2
                if res.is_integer():
                    result = f"{self.format_number(v1)} × {self.format_number(v2)} = {int(res)}"
                else:
                    result = f"{self.format_number(v1)} × {self.format_number(v2)} = {res:.10f}".rstrip('0').rstrip('.')
                
            elif operation == "Деление (/)":
                v1 = float(values[0])
                v2 = float(values[1])
                if v2 == 0:
                    messagebox.showerror("Ошибка", "Деление на ноль невозможно!")
                    return
                res = v1 / v2
                # Для деления показываем больше знаков
                result = f"{self.format_number(v1)} ÷ {self.format_number(v2)} = {res:.15f}".rstrip('0').rstrip('.')
                
            elif operation == "Возведение в степень (**)":
                v1 = float(values[0])
                v2 = float(values[1])
                res = v1 ** v2
                if res.is_integer() and res < 1e15:
                    result = f"{self.format_number(v1)} ^ {self.format_number(v2)} = {int(res)}"
                else:
                    result = f"{self.format_number(v1)} ^ {self.format_number(v2)} = {res:.10f}".rstrip('0').rstrip('.')
                
            elif operation == "Квадратный корень (√)":
                v1 = float(values[0])
                if v1 < 0:
                    messagebox.showerror("Ошибка", "Нельзя извлечь квадратный корень из отрицательного числа")
                    return
                res = math.sqrt(v1)
                if res.is_integer():
                    result = f"√{self.format_number(v1)} = {int(res)}"
                else:
                    result = f"√{self.format_number(v1)} = {res:.10f}".rstrip('0').rstrip('.')
                
            elif operation == "Кубический корень (∛)":
                v1 = float(values[0])
                if v1 >= 0:
                    res = v1 ** (1/3)
                else:
                    res = -((-v1) ** (1/3))
                if abs(res - round(res)) < 1e-10:
                    result = f"∛{self.format_number(v1)} = {round(res)}"
                else:
                    result = f"∛{self.format_number(v1)} = {res:.10f}".rstrip('0').rstrip('.')
                
            elif operation == "Факториал числа (n!)":
                num = values[0]
                # Проверяем, что число целое
                if float(num) != int(float(num)):
                    messagebox.showerror("Ошибка", "Факториал определен только для целых чисел")
                    return
                n = int(float(num))
                if n < 0:
                    messagebox.showerror("Ошибка", "Факториал отрицательного числа не определен")
                    return
                if n > 100:
                    messagebox.showwarning("Предупреждение", "Число большое, вычисление может занять время")
                
                # Вычисляем факториал точно
                fact = 1
                for i in range(1, n + 1):
                    fact *= i
                result = f"{n}! = {fact}"
                
            elif operation == "Индекс массы тела (ИМТ)":
                weight = float(values[0])
                height = float(values[1])
                if height <= 0:
                    messagebox.showerror("Ошибка", "Рост должен быть положительным")
                    return
                bmi = weight / (height ** 2)
                
                # Форматируем ИМТ с точностью до 2 знаков
                bmi_formatted = f"{bmi:.2f}"
                
                if bmi < 18.5:
                    interpretation = "Дефицит массы тела"
                elif bmi < 25:
                    interpretation = "Норма"
                elif bmi < 30:
                    interpretation = "Избыточная масса тела"
                else:
                    interpretation = "Ожирение"
                result = f"ИМТ = {bmi_formatted}\nИнтерпретация: {interpretation}"
                
            elif operation == "Квадратное уравнение":
                a = float(values[0])
                b = float(values[1])
                c = float(values[2])
                
                if a == 0:
                    messagebox.showerror("Ошибка", "Коэффициент a не может быть равен 0")
                    return
                
                discriminant = b**2 - 4*a*c
                
                if discriminant < 0:
                    result = "Нет действительных корней"
                elif discriminant == 0:
                    x = -b / (2*a)
                    if x.is_integer():
                        result = f"Один корень: x = {int(x)}"
                    else:
                        result = f"Один корень: x = {x:.6f}".rstrip('0').rstrip('.')
                else:
                    x1 = (-b + math.sqrt(discriminant)) / (2*a)
                    x2 = (-b - math.sqrt(discriminant)) / (2*a)
                    result = f"Два корня:\nx₁ = {x1:.8f}".rstrip('0').rstrip('.') + f"\nx₂ = {x2:.8f}".rstrip('0').rstrip('.')
                    
            elif operation == "Проценты (X% от Y)":
                percent = float(values[0])
                number = float(values[1])
                result_val = (percent / 100) * number
                if result_val.is_integer():
                    result = f"{self.format_number(percent)}% от {self.format_number(number)} = {int(result_val)}"
                else:
                    result = f"{self.format_number(percent)}% от {self.format_number(number)} = {result_val:.10f}".rstrip('0').rstrip('.')
                
            elif operation == "Перевод температур":
                direction = self.input_entries['direction'].get()
                temp = float(values[0])
                
                if direction == "Цельсий -> Фаренгейт":
                    converted = (temp * 9/5) + 32
                    if converted.is_integer():
                        result = f"{temp}°C = {int(converted)}°F"
                    else:
                        result = f"{temp}°C = {converted:.2f}°F"
                elif direction == "Фаренгейт -> Цельсий":
                    converted = (temp - 32) * 5/9
                    if abs(converted - round(converted)) < 1e-10:
                        result = f"{temp}°F = {int(round(converted))}°C"
                    else:
                        result = f"{temp}°F = {converted:.2f}°C"
                elif direction == "Цельсий -> Кельвин":
                    converted = temp + 273.15
                    if converted.is_integer():
                        result = f"{temp}°C = {int(converted)}K"
                    else:
                        result = f"{temp}°C = {converted:.2f}K"
                elif direction == "Кельвин -> Цельсий":
                    if temp < 0:
                        messagebox.showerror("Ошибка", "Температура в Кельвинах не может быть отрицательной")
                        return
                    converted = temp - 273.15
                    if abs(converted - round(converted)) < 1e-10:
                        result = f"{temp}K = {int(round(converted))}°C"
                    else:
                        result = f"{temp}K = {converted:.2f}°C"
            
            self.result_label.config(text=result)
            
        except ValueError as e:
            messagebox.showerror("Ошибка ввода", str(e))
        except OverflowError:
            messagebox.showerror("Ошибка", "Результат слишком большой для вычисления")
        except Exception as e:
            messagebox.showerror("Ошибка", f"Произошла ошибка: {str(e)}")
    
    def format_number(self, num):
        """Форматирует число для отображения (убирает лишние нули)"""
        if isinstance(num, float):
            if num.is_integer():
                return str(int(num))
            else:
                return str(num).rstrip('0').rstrip('.')
        return str(num)

if __name__ == "__main__":
    root = tk.Tk()
    app = CalculatorApp(root)
    root.mainloop()

