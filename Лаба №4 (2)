import tkinter as tk
from tkinter import ttk, messagebox
import math

class CalculatorApp:
    def __init__(self, root):
        self.root = root
        self.root.title("Калькулятор")
        self.root.geometry("500x650")
        self.root.resizable(True, True)  # Разрешаем изменение размера
        self.root.configure(bg='#2d2d2d')
        
        # Переменные для полноэкранного режима
        self.is_fullscreen = False
        self.normal_size = "500x650"
        
        # Переменные
        self.current_input = ""
        self.current_operation = ""
        self.first_number = None
        self.waiting_for_second = False
        self.mode = "Стандартный"
        
        # Создание интерфейса
        self.setup_ui()
        
        # Привязка клавиатуры
        self.bind_keyboard()
        
        # Привязка клавиши Escape для выхода из полноэкранного режима
        self.root.bind('<Escape>', self.exit_fullscreen)
        
    def toggle_fullscreen(self, event=None):
        """Переключение полноэкранного режима"""
        self.is_fullscreen = not self.is_fullscreen
        self.root.attributes('-fullscreen', self.is_fullscreen)
        if not self.is_fullscreen:
            self.root.geometry(self.normal_size)
    
    def exit_fullscreen(self, event=None):
        """Выход из полноэкранного режима по Escape"""
        if self.is_fullscreen:
            self.is_fullscreen = False
            self.root.attributes('-fullscreen', False)
            self.root.geometry(self.normal_size)
    
    def setup_ui(self):
        style = ttk.Style()
        style.theme_use('clam')
        style.configure('TFrame', background='#2d2d2d')
        style.configure('TLabel', background='#2d2d2d', foreground='white')
        
        # Основной фрейм с возможностью растягиваться
        main_frame = ttk.Frame(self.root)
        main_frame.pack(fill=tk.BOTH, expand=True, padx=10, pady=10)
        
        # Выпадающий список для выбора режима
        mode_frame = ttk.Frame(main_frame)
        mode_frame.pack(fill=tk.X, pady=(0, 10))
        
        ttk.Label(mode_frame, text="Режим:", font=('Arial', 10)).pack(side=tk.LEFT, padx=(0, 5))
        self.mode_var = tk.StringVar(value="Стандартный")
        mode_combo = ttk.Combobox(mode_frame, textvariable=self.mode_var, 
                                  values=["Стандартный", "Расширенный"], 
                                  state="readonly", width=15)
        mode_combo.pack(side=tk.LEFT)
        mode_combo.bind('<<ComboboxSelected>>', self.on_mode_change)
        
        # Дисплей
        self.display_frame = tk.Frame(main_frame, bg='#1e1e1e', relief=tk.FLAT, bd=0)
        self.display_frame.pack(fill=tk.BOTH, pady=(0, 10))
        
        self.display_var = tk.StringVar(value="0")
        self.display_label = tk.Label(self.display_frame, textvariable=self.display_var, 
                                      font=('Arial', 28, 'bold'), bg='#1e1e1e', 
                                      fg='white', anchor=tk.E, padx=10, pady=20)
        self.display_label.pack(fill=tk.BOTH)
        
        # Фрейм для кнопок
        self.buttons_frame = tk.Frame(main_frame, bg='#2d2d2d')
        self.buttons_frame.pack(fill=tk.BOTH, expand=True)
        
        self.create_standard_buttons()
        
        # Привязка изменения размера окна для динамической подстройки шрифтов
        self.root.bind('<Configure>', self.on_window_resize)
        
    def on_window_resize(self, event=None):
        """Адаптация размера шрифта при изменении окна"""
        if event.widget == self.root:
            # Получаем текущий размер окна
            width = self.root.winfo_width()
            height = self.root.winfo_height()
            
            # Адаптируем размер шрифта дисплея
            if width > 800:
                display_font_size = 48
            elif width > 600:
                display_font_size = 36
            else:
                display_font_size = 28
            
            self.display_label.config(font=('Arial', display_font_size, 'bold'))
            
            # Пересоздаем кнопки с новыми размерами шрифтов
            self.create_standard_buttons()
    
    def create_standard_buttons(self):
        for widget in self.buttons_frame.winfo_children():
            widget.destroy()
        
        colors = {
            'number': '#4a4a4a',
            'operator': '#ff9500',
            'function': '#3a3a3a',
            'clear': '#ff3b30',
            'equal': '#28a745',
            'special': '#5856d6'
        }
        
        # Определяем размеры шрифтов в зависимости от размера окна
        window_width = self.root.winfo_width()
        if window_width > 800:
            number_font = ('Arial', 20, 'bold')
            operator_font = ('Arial', 20, 'bold')
            special_font = ('Arial', 14, 'bold')
            func_font = ('Arial', 18, 'bold')
            clear_font = ('Arial', 18, 'bold')
            equal_font = ('Arial', 20, 'bold')
        elif window_width > 600:
            number_font = ('Arial', 18, 'bold')
            operator_font = ('Arial', 18, 'bold')
            special_font = ('Arial', 12, 'bold')
            func_font = ('Arial', 16, 'bold')
            clear_font = ('Arial', 16, 'bold')
            equal_font = ('Arial', 18, 'bold')
        else:
            number_font = ('Arial', 16, 'bold')
            operator_font = ('Arial', 16, 'bold')
            special_font = ('Arial', 11, 'bold')
            func_font = ('Arial', 14, 'bold')
            clear_font = ('Arial', 14, 'bold')
            equal_font = ('Arial', 16, 'bold')
        
        if self.mode == "Стандартный":
            buttons = [
                ['C', '⌫', '', '/'],
                ['7', '8', '9', '*'],
                ['4', '5', '6', '-'],
                ['1', '2', '3', '+'],
                ['0', '.', '=', '']
            ]
        else:  # Расширенный режим
            buttons = [
                ['C', '⌫', '√', '∛'],
                ['7', '8', '9', '/'],
                ['4', '5', '6', '*'],
                ['1', '2', '3', '-'],
                ['0', '.', '=', '+'],
                ['xʸ', 'n!', 'ИМТ', '%'],
                ['Квадратное уравнение', 'Перевод температур', '', '']
            ]
        
        for i, row in enumerate(buttons):
            for j, button_text in enumerate(row):
                if button_text == '':
                    continue
                    
                if button_text in ['C', '⌫']:
                    color = colors['clear']
                    font = clear_font
                elif button_text == '=':
                    color = colors['equal']
                    font = equal_font
                elif button_text in ['/', '*', '-', '+', 'xʸ']:
                    color = colors['operator']
                    font = operator_font
                elif button_text in ['√', '∛', 'n!', '%']:
                    color = colors['function']
                    font = func_font
                elif button_text in ['ИМТ', 'Квадратное уравнение', 'Перевод температур']:
                    color = colors['special']
                    font = special_font
                elif button_text.isdigit() or button_text == '.':
                    color = colors['number']
                    font = number_font
                else:
                    color = colors['number']
                    font = number_font
                
                btn = tk.Button(self.buttons_frame, text=button_text, font=font,
                               bg=color, fg='white', bd=0, relief=tk.RAISED,
                               activebackground=self.lighten_color(color),
                               command=lambda x=button_text: self.on_button_click(x))
                btn.grid(row=i, column=j, padx=2, pady=2, sticky='nsew')
        
        for i in range(len(buttons)):
            self.buttons_frame.grid_rowconfigure(i, weight=1)
        for j in range(4):
            self.buttons_frame.grid_columnconfigure(j, weight=1)
    
    def lighten_color(self, color):
        colors_map = {
            '#4a4a4a': '#5a5a5a',
            '#ff9500': '#ffaa33',
            '#3a3a3a': '#4a4a4a',
            '#ff3b30': '#ff5e55',
            '#28a745': '#34ce57',
            '#5856d6': '#6c6aff'
        }
        return colors_map.get(color, '#666666')
    
    def on_mode_change(self, event=None):
        self.mode = self.mode_var.get()
        self.clear_all()
        self.create_standard_buttons()
    
    def on_button_click(self, button_text):
        if button_text == 'C':
            self.clear_all()
        elif button_text == '⌫':
            self.backspace()
        elif button_text == '=':
            self.calculate_result()
        elif button_text in ['+', '-', '*', '/', 'xʸ']:
            self.handle_operator(button_text)
        elif button_text == '√':
            self.calculate_sqrt()
        elif button_text == '∛':
            self.calculate_cbrt()
        elif button_text == 'n!':
            self.calculate_factorial()
        elif button_text == 'ИМТ':
            self.calculate_bmi()
        elif button_text == '%':
            self.calculate_percent()
        elif button_text == 'Квадратное уравнение':
            self.solve_quadratic()
        elif button_text == 'Перевод температур':
            self.convert_temperature()
        else:
            self.add_to_display(button_text)
    
    def add_to_display(self, value):
        if self.waiting_for_second:
            self.current_input = ""
            self.waiting_for_second = False
        
        if self.current_input == "0" and value != ".":
            self.current_input = value
        else:
            self.current_input += value
        
        self.update_display()
    
    def update_display(self):
        if self.current_input == "":
            self.display_var.set("0")
        else:
            self.display_var.set(self.current_input)
    
    def clear_all(self):
        self.current_input = ""
        self.first_number = None
        self.current_operation = ""
        self.waiting_for_second = False
        self.update_display()
    
    def backspace(self):
        if self.waiting_for_second:
            return
        self.current_input = self.current_input[:-1]
        if self.current_input == "":
            self.current_input = "0"
        self.update_display()
    
    def handle_operator(self, operator):
        try:
            if self.current_input and not self.waiting_for_second:
                if self.first_number is None:
                    self.first_number = float(self.current_input)
                elif self.current_operation:
                    self.calculate_result()
                    self.first_number = float(self.current_input)
                
                self.current_operation = operator
                self.waiting_for_second = True
        except:
            messagebox.showerror("Ошибка", "Некорректный ввод")
    
    def calculate_result(self):
        try:
            if self.first_number is not None and self.current_operation and self.current_input:
                second_number = float(self.current_input)
                
                if self.current_operation == '+':
                    result = self.first_number + second_number
                elif self.current_operation == '-':
                    result = self.first_number - second_number
                elif self.current_operation == '*':
                    result = self.first_number * second_number
                elif self.current_operation == '/':
                    if second_number == 0:
                        messagebox.showerror("Ошибка", "Деление на ноль!")
                        self.clear_all()
                        return
                    result = self.first_number / second_number
                elif self.current_operation == 'xʸ':
                    result = self.first_number ** second_number
                else:
                    return
                
                if result == int(result):
                    self.current_input = str(int(result))
                else:
                    self.current_input = str(round(result, 10)).rstrip('0').rstrip('.')
                
                self.first_number = None
                self.current_operation = ""
                self.waiting_for_second = False
                self.update_display()
                
        except OverflowError:
            messagebox.showerror("Ошибка", "Результат слишком большой")
            self.clear_all()
        except Exception as e:
            messagebox.showerror("Ошибка", f"Ошибка вычисления: {str(e)}")
            self.clear_all()
    
    def calculate_sqrt(self):
        try:
            if self.current_input:
                num = float(self.current_input)
                if num < 0:
                    messagebox.showerror("Ошибка", "Нельзя извлечь квадратный корень из отрицательного числа")
                    return
                result = math.sqrt(num)
                if result == int(result):
                    self.current_input = str(int(result))
                else:
                    self.current_input = str(round(result, 10)).rstrip('0').rstrip('.')
                self.update_display()
                self.first_number = None
                self.current_operation = ""
        except:
            messagebox.showerror("Ошибка", "Некорректный ввод")
    
    def calculate_cbrt(self):
        try:
            if self.current_input:
                num = float(self.current_input)
                if num >= 0:
                    result = num ** (1/3)
                else:
                    result = -((-num) ** (1/3))
                
                if abs(result - round(result)) < 1e-10:
                    self.current_input = str(int(round(result)))
                else:
                    self.current_input = str(round(result, 10)).rstrip('0').rstrip('.')
                self.update_display()
                self.first_number = None
                self.current_operation = ""
        except:
            messagebox.showerror("Ошибка", "Некорректный ввод")
    
    def calculate_factorial(self):
        try:
            if self.current_input:
                num = float(self.current_input)
                if num != int(num):
                    messagebox.showerror("Ошибка", "Факториал определен только для целых чисел")
                    return
                n = int(num)
                if n < 0:
                    messagebox.showerror("Ошибка", "Факториал отрицательного числа не определен")
                    return
                if n > 100:
                    if not messagebox.askyesno("Предупреждение", "Число большое, вычисление может занять время. Продолжить?"):
                        return
                
                fact = 1
                for i in range(1, n + 1):
                    fact *= i
                
                self.current_input = str(fact)
                self.update_display()
                self.first_number = None
                self.current_operation = ""
        except:
            messagebox.showerror("Ошибка", "Некорректный ввод")
    
    def calculate_bmi(self):
        try:
            # Создаем диалоговое окно для ввода веса и роста
            dialog = tk.Toplevel(self.root)
            dialog.title("Индекс массы тела")
            dialog.geometry("300x200")
            dialog.configure(bg='#2d2d2d')
            dialog.resizable(False, False)
            
            tk.Label(dialog, text="Вес (кг):", bg='#2d2d2d', fg='white', font=('Arial', 12)).pack(pady=10)
            weight_entry = tk.Entry(dialog, font=('Arial', 12), width=20)
            weight_entry.pack()
            
            tk.Label(dialog, text="Рост (м):", bg='#2d2d2d', fg='white', font=('Arial', 12)).pack(pady=10)
            height_entry = tk.Entry(dialog, font=('Arial', 12), width=20)
            height_entry.pack()
            
            def calculate():
                try:
                    weight = float(weight_entry.get())
                    height = float(height_entry.get())
                    if height <= 0:
                        messagebox.showerror("Ошибка", "Рост должен быть положительным")
                        return
                    
                    bmi = weight / (height ** 2)
                    
                    if bmi < 18.5:
                        interpretation = "Дефицит массы тела"
                    elif bmi < 25:
                        interpretation = "Норма"
                    elif bmi < 30:
                        interpretation = "Избыточная масса тела"
                    else:
                        interpretation = "Ожирение"
                    
                    result_text = f"ИМТ = {bmi:.2f}\n\n{interpretation}"
                    messagebox.showinfo("Результат", result_text)
                    dialog.destroy()
                    
                except ValueError:
                    messagebox.showerror("Ошибка", "Введите корректные числа")
            
            tk.Button(dialog, text="Вычислить", command=calculate, bg='#28a745', fg='white', 
                     font=('Arial', 12), padx=20, pady=5).pack(pady=20)
            
        except:
            messagebox.showerror("Ошибка", "Некорректный ввод")
    
    def calculate_percent(self):
        try:
            dialog = tk.Toplevel(self.root)
            dialog.title("Проценты")
            dialog.geometry("300x220")
            dialog.configure(bg='#2d2d2d')
            dialog.resizable(False, False)
            
            tk.Label(dialog, text="Процент (%):", bg='#2d2d2d', fg='white', font=('Arial', 12)).pack(pady=10)
            percent_entry = tk.Entry(dialog, font=('Arial', 12), width=20)
            percent_entry.pack()
            
            tk.Label(dialog, text="Число:", bg='#2d2d2d', fg='white', font=('Arial', 12)).pack(pady=10)
            number_entry = tk.Entry(dialog, font=('Arial', 12), width=20)
            number_entry.pack()
            
            def calculate():
                try:
                    percent = float(percent_entry.get())
                    number = float(number_entry.get())
                    result = (percent / 100) * number
                    
                    if result == int(result):
                        messagebox.showinfo("Результат", f"{percent}% от {number} = {int(result)}")
                    else:
                        messagebox.showinfo("Результат", f"{percent}% от {number} = {result:.10f}".rstrip('0').rstrip('.'))
                    dialog.destroy()
                    
                except ValueError:
                    messagebox.showerror("Ошибка", "Введите корректные числа")
            
            tk.Button(dialog, text="Вычислить", command=calculate, bg='#28a745', fg='white', 
                     font=('Arial', 12), padx=20, pady=5).pack(pady=20)
            
        except:
            messagebox.showerror("Ошибка", "Некорректный ввод")
    
    def solve_quadratic(self):
        try:
            dialog = tk.Toplevel(self.root)
            dialog.title("Квадратное уравнение")
            dialog.geometry("300x250")
            dialog.configure(bg='#2d2d2d')
            dialog.resizable(False, False)
            
            tk.Label(dialog, text="Коэффициент a:", bg='#2d2d2d', fg='white', font=('Arial', 12)).pack(pady=5)
            a_entry = tk.Entry(dialog, font=('Arial', 12), width=20)
            a_entry.pack()
            
            tk.Label(dialog, text="Коэффициент b:", bg='#2d2d2d', fg='white', font=('Arial', 12)).pack(pady=5)
            b_entry = tk.Entry(dialog, font=('Arial', 12), width=20)
            b_entry.pack()
            
            tk.Label(dialog, text="Коэффициент c:", bg='#2d2d2d', fg='white', font=('Arial', 12)).pack(pady=5)
            c_entry = tk.Entry(dialog, font=('Arial', 12), width=20)
            c_entry.pack()
            
            def calculate():
                try:
                    a = float(a_entry.get())
                    b = float(b_entry.get())
                    c = float(c_entry.get())
                    
                    if a == 0:
                        messagebox.showerror("Ошибка", "Коэффициент a не может быть равен 0")
                        return
                    
                    discriminant = b**2 - 4*a*c
                    
                    if discriminant < 0:
                        result_text = "Нет действительных корней"
                    elif discriminant == 0:
                        x = -b / (2*a)
                        if x == int(x):
                            result_text = f"Один корень: x = {int(x)}"
                        else:
                            result_text = f"Один корень: x = {x:.6f}".rstrip('0').rstrip('.')
                    else:
                        x1 = (-b + math.sqrt(discriminant)) / (2*a)
                        x2 = (-b - math.sqrt(discriminant)) / (2*a)
                        result_text = f"Два корня:\nx₁ = {x1:.8f}".rstrip('0').rstrip('.') + f"\nx₂ = {x2:.8f}".rstrip('0').rstrip('.')
                    
                    messagebox.showinfo("Результат", result_text)
                    dialog.destroy()
                    
                except ValueError:
                    messagebox.showerror("Ошибка", "Введите корректные числа")
            
            tk.Button(dialog, text="Решить", command=calculate, bg='#28a745', fg='white', 
                     font=('Arial', 12), padx=20, pady=5).pack(pady=15)
            
        except:
            messagebox.showerror("Ошибка", "Некорректный ввод")
    
    def convert_temperature(self):
        try:
            dialog = tk.Toplevel(self.root)
            dialog.title("Перевод температур")
            dialog.geometry("350x250")
            dialog.configure(bg='#2d2d2d')
            dialog.resizable(False, False)
            
            tk.Label(dialog, text="Направление:", bg='#2d2d2d', fg='white', font=('Arial', 12)).pack(pady=10)
            direction_var = tk.StringVar(value="Цельсий -> Фаренгейт")
            directions = ["Цельсий -> Фаренгейт", "Фаренгейт -> Цельсий", "Цельсий -> Кельвин", "Кельвин -> Цельсий"]
            direction_combo = ttk.Combobox(dialog, textvariable=direction_var, values=directions, state="readonly", width=25)
            direction_combo.pack()
            
            tk.Label(dialog, text="Температура:", bg='#2d2d2d', fg='white', font=('Arial', 12)).pack(pady=10)
            temp_entry = tk.Entry(dialog, font=('Arial', 12), width=20)
            temp_entry.pack()
            
            def calculate():
                try:
                    temp = float(temp_entry.get())
                    direction = direction_var.get()
                    
                    if direction == "Цельсий -> Фаренгейт":
                        converted = (temp * 9/5) + 32
                        result_text = f"{temp}°C = {converted:.2f}°F"
                    elif direction == "Фаренгейт -> Цельсий":
                        converted = (temp - 32) * 5/9
                        result_text = f"{temp}°F = {converted:.2f}°C"
                    elif direction == "Цельсий -> Кельвин":
                        converted = temp + 273.15
                        result_text = f"{temp}°C = {converted:.2f}K"
                    elif direction == "Кельвин -> Цельсий":
                        if temp < 0:
                            messagebox.showerror("Ошибка", "Температура в Кельвинах не может быть отрицательной")
                            return
                        converted = temp - 273.15
                        result_text = f"{temp}K = {converted:.2f}°C"
                    else:
                        return
                    
                    messagebox.showinfo("Результат", result_text)
                    dialog.destroy()
                    
                except ValueError:
                    messagebox.showerror("Ошибка", "Введите корректное число")
            
            tk.Button(dialog, text="Перевести", command=calculate, bg='#28a745', fg='white', 
                     font=('Arial', 12), padx=20, pady=5).pack(pady=20)
            
        except:
            messagebox.showerror("Ошибка", "Некорректный ввод")
    
    def bind_keyboard(self):
        self.root.bind('<Key>', self.on_key_press)
    
    def on_key_press(self, event):
        key = event.char
        
        if key.isdigit() or key == '.':
            self.on_button_click(key)
        elif key in ['+', '-', '*', '/']:
            self.on_button_click(key)
        elif key == '\r':
            self.on_button_click('=')
        elif key == '\x08':
            self.on_button_click('⌫')
        elif key == 'c' or key == 'C':
            self.on_button_click('C')

if __name__ == "__main__":
    root = tk.Tk()
    app = CalculatorApp(root)
    root.mainloop()
