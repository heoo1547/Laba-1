<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover, user-scalable=no">
  <title>Калькулятор | Мобильное приложение</title>
  <style>
    /* ============================================ */
    /* БЛОК 1: Глобальный сброс стилей              */
    /* ============================================ */
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      user-select: none; /* предотвращает случайное выделение текста на кнопках */
      -webkit-tap-highlight-color: transparent; /* убирает серый фон при тапе на iOS */
    }

    /* ============================================ */
    /* БЛОК 2: Стилизация тела страницы             */
    /* ============================================ */
    body {
      font-family: system-ui, -apple-system, 'Segoe UI', 'Roboto', 'Helvetica Neue', sans-serif;
      background: #1c1c1e;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      margin: 0;
      padding: 16px;
    }

    /* ============================================ */
    /* БЛОК 3: Основной контейнер калькулятора      */
    /* ============================================ */
    .calculator-app {
      max-width: 400px;
      width: 100%;
      background-color: #000000;
      border-radius: 48px;
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
      overflow: hidden;
      padding: 20px 16px 32px 16px;
      transition: all 0.2s ease;
    }

    /* ============================================ */
    /* БЛОК 4: Дисплей калькулятора                 */
    /* ============================================ */
    .display {
      background-color: #000000;
      padding: 20px 16px 30px 16px;
      text-align: right;
      border-bottom: 1px solid #2c2c2e;
    }

    .expression {
      font-size: 2rem;
      color: #8e8e93;
      min-height: 3rem;
      word-wrap: break-word;
      word-break: break-all;
      font-weight: 400;
      letter-spacing: 0.5px;
    }

    .result {
      font-size: 4rem;
      font-weight: 500;
      color: #ffffff;
      margin-top: 8px;
      word-wrap: break-word;
      word-break: break-word;
      line-height: 1.2;
      min-height: 5.5rem;
      font-weight: 500;
    }

    /* ============================================ */
    /* БЛОК 5: Сетка кнопок                         */
    /* ============================================ */
    .buttons {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 12px;
      margin-top: 16px;
      padding: 4px;
    }

    /* ============================================ */
    /* БЛОК 6: Базовый стиль всех кнопок            */
    /* ============================================ */
    .btn {
      aspect-ratio: 1 / 1;
      border: none;
      border-radius: 60px;
      font-size: 2rem;
      font-weight: 500;
      background-color: #2c2c2e;
      color: white;
      cursor: pointer;
      transition: all 0.1s ease;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: inherit;
      box-shadow: 0 1px 1px rgba(0,0,0,0.2);
      touch-action: manipulation;
    }

    /* Эффект нажатия на кнопку */
    .btn:active {
      transform: scale(0.96);
      opacity: 0.8;
    }

    /* ============================================ */
    /* БЛОК 7: Специфичные типы кнопок              */
    /* ============================================ */
    .btn-function {
      background-color: #5e5e62;
      color: #ffffff;
      font-weight: 500;
    }

    .btn-operator {
      background-color: #ff9f0a;
      color: white;
      font-size: 2.2rem;
      font-weight: 600;
    }

    .btn-equals {
      background-color: #ff9f0a;
      color: white;
      font-size: 2rem;
      font-weight: 600;
    }

    /* Кнопка 0 занимает две колонки */
    .btn-zero {
      grid-column: span 2;
      aspect-ratio: 2 / 1;
    }

    .btn-clear {
      background-color: #5e5e62;
      color: #ffffff;
    }

    /* ============================================ */
    /* БЛОК 8: Адаптивность для разных экранов      */
    /* ============================================ */
    @media (max-width: 420px) {
      .calculator-app {
        padding: 12px 12px 24px 12px;
      }
      .buttons {
        gap: 10px;
      }
      .btn {
        font-size: 1.8rem;
      }
      .result {
        font-size: 3.2rem;
      }
      .expression {
        font-size: 1.5rem;
      }
    }

    @media (max-width: 340px) {
      .btn {
        font-size: 1.5rem;
      }
      .buttons {
        gap: 8px;
      }
    }

    /* Для доступности с клавиатуры */
    .btn:focus-visible {
      outline: 2px solid #ff9f0a;
      outline-offset: 2px;
    }

    footer {
      text-align: center;
      margin-top: 20px;
      font-size: 12px;
      color: #636366;
      font-weight: 400;
    }
  </style>
</head>
<body>
<div class="calculator-app">
  <!-- ============================================ -->
  <!-- БЛОК 9: HTML структура дисплея               -->
  /* ============================================ */
  <div class="display">
    <div class="expression" id="expression">0</div>
    <div class="result" id="result">0</div>
  </div>
  
  <!-- ============================================ -->
  <!-- БЛОК 10: Контейнер для кнопок                -->
  <!-- Кнопки будут добавлены динамически через JS  -->
  /* ============================================ */
  <div class="buttons" id="buttons-container"></div>
  
  <footer style="font-size: 10px; text-align: center; color: #636366; margin-top: 12px;">=  мобильный калькулятор</footer>
</div>

<script>
  // ============================================ */
  // БЛОК 11: Получение DOM элементов
  // ============================================ */
  const expressionEl = document.getElementById('expression');
  const resultEl = document.getElementById('result');

  // ============================================ */
  // БЛОК 12: Состояния калькулятора
  // ============================================ */
  let currentInput = '0';        // то, что сейчас набирает пользователь или результат
  let previousInput = null;      // предыдущее значение (для операций)
  let currentOperator = null;    // текущий выбранный оператор (+, -, ×, ÷)
  let waitingForOperand = false; // ожидание ввода операнда после оператора
  let lastActionWasEqual = false; // чтобы правильно обрабатывать последующие действия после "="

  // ============================================ */
  // БЛОК 13: Обновление дисплея
  // ============================================ */
  function updateDisplay() {
    // Форматируем текущий ввод для отображения
    let displayValue = currentInput;
    if (displayValue === '' || displayValue === undefined) displayValue = '0';
    
    // Убираем завершающую точку, если есть
    if (displayValue.endsWith('.')) displayValue = displayValue.slice(0, -1);
    
    // Ограничиваем длину, чтобы не ломать интерфейс
    if (displayValue.length > 18) {
      let num = parseFloat(displayValue);
      if (!isNaN(num)) {
        displayValue = num.toPrecision(12).replace(/\.?0+$/, '');
      } else {
        displayValue = displayValue.slice(0, 16);
      }
    }
    resultEl.innerText = displayValue;

    // Формируем строку выражения для верхней части
    if (currentOperator && previousInput !== null && !waitingForOperand) {
      let prevFormatted = previousInput;
      if (typeof prevFormatted === 'number') {
        prevFormatted = parseFloat(prevFormatted.toFixed(10)).toString();
      }
      let opSymbol = '';
      if (currentOperator === '+') opSymbol = '+';
      else if (currentOperator === '-') opSymbol = '-';
      else if (currentOperator === '*') opSymbol = '×';
      else if (currentOperator === '/') opSymbol = '÷';
      expressionEl.innerText = `${prevFormatted} ${opSymbol} ${displayValue}`;
    } 
    else if (previousInput !== null && waitingForOperand && currentOperator) {
      let prevFormatted = previousInput;
      if (typeof prevFormatted === 'number') prevFormatted = parseFloat(prevFormatted.toFixed(10)).toString();
      let opSymbol = '';
      if (currentOperator === '+') opSymbol = '+';
      else if (currentOperator === '-') opSymbol = '-';
      else if (currentOperator === '*') opSymbol = '×';
      else if (currentOperator === '/') opSymbol = '÷';
      expressionEl.innerText = `${prevFormatted} ${opSymbol}`;
    }
    else {
      expressionEl.innerText = displayValue;
    }
    
    if (lastActionWasEqual && currentOperator === null && previousInput === null) {
      expressionEl.innerText = displayValue;
    }
  }

  // ============================================ */
  // БЛОК 14: Выполнение арифметической операции
  // ============================================ */
  function calculateResult() {
    if (currentOperator === null || previousInput === null || waitingForOperand) {
      return false;
    }
    
    let a = parseFloat(previousInput);
    let b = parseFloat(currentInput);
    if (isNaN(a) || isNaN(b)) return false;

    let computedValue;
    switch (currentOperator) {
      case '+':
        computedValue = a + b;
        break;
      case '-':
        computedValue = a - b;
        break;
      case '*':
        computedValue = a * b;
        break;
      case '/':
        if (b === 0) {
          // Деление на ноль — показываем ошибку
          currentInput = 'Ошибка';
          previousInput = null;
          currentOperator = null;
          waitingForOperand = false;
          lastActionWasEqual = false;
          updateDisplay();
          return false;
        }
        computedValue = a / b;
        break;
      default:
        return false;
    }
    
    // Округляем погрешность с плавающей точкой
    computedValue = parseFloat(computedValue.toFixed(10));
    let resultStr = computedValue.toString();
    if (resultStr.includes('.') && resultStr.endsWith('.0')) resultStr = resultStr.slice(0, -2);
    
    currentInput = resultStr;
    previousInput = null;
    currentOperator = null;
    waitingForOperand = false;
    lastActionWasEqual = true;
    updateDisplay();
    return true;
  }

  // ============================================ */
  // БЛОК 15: Ввод цифр и десятичной точки
  // ============================================ */
  function inputDigit(digit) {
    // Если последнее действие было "=", начинаем новый ввод
    if (lastActionWasEqual) {
      clearAll();
      lastActionWasEqual = false;
    }
    
    // Если ожидание операнда, сбрасываем текущий ввод
    if (waitingForOperand) {
      currentInput = digit;
      waitingForOperand = false;
      lastActionWasEqual = false;
    } else {
      // Предотвращаем множественные ведущие нули
      if (currentInput === '0' && digit !== '.') {
        currentInput = digit;
      } 
      // Обработка десятичной точки
      else if (digit === '.') {
        if (!currentInput.includes('.')) {
          currentInput += '.';
        }
      }
      else {
        // Ограничение длины ввода
        if (currentInput.replace(/\./g, '').length < 15) {
          currentInput += digit;
        }
      }
    }
    updateDisplay();
  }

  function inputDecimal() {
    if (lastActionWasEqual) {
      clearAll();
      lastActionWasEqual = false;
    }
    if (waitingForOperand) {
      currentInput = '0.';
      waitingForOperand = false;
    } else {
      if (!currentInput.includes('.')) {
        currentInput += '.';
      }
    }
    updateDisplay();
  }

  // ============================================ */
  // БЛОК 16: Обработка операторов (+, -, ×, ÷)
  // ============================================ */
  function handleOperator(op) {
    // Если была ошибка, сбрасываем
    if (currentInput === 'Ошибка') {
      clearAll();
    }

    // Если последнее действие "=", используем результат как первый операнд
    if (lastActionWasEqual) {
      previousInput = currentInput;
      waitingForOperand = true;
      currentOperator = op;
      lastActionWasEqual = false;
      updateDisplay();
      return;
    }

    // Если нет активного оператора, просто сохраняем текущее значение
    if (currentOperator === null || previousInput === null) {
      if (currentInput !== '' && currentInput !== 'Ошибка') {
        previousInput = currentInput;
        currentOperator = op;
        waitingForOperand = true;
        updateDisplay();
      }
      return;
    }
    
    // Если есть оператор, выполняем предыдущую операцию
    if (!waitingForOperand && previousInput !== null && currentOperator !== null) {
      let a = parseFloat(previousInput);
      let b = parseFloat(currentInput);
      if (!isNaN(a) && !isNaN(b)) {
        let tempResult;
        switch (currentOperator) {
          case '+': tempResult = a + b; break;
          case '-': tempResult = a - b; break;
          case '*': tempResult = a * b; break;
          case '/': 
            if (b === 0) {
              currentInput = 'Ошибка';
              previousInput = null;
              currentOperator = null;
              waitingForOperand = false;
              updateDisplay();
              return;
            }
            tempResult = a / b; break;
          default: tempResult = b;
        }
        tempResult = parseFloat(tempResult.toFixed(10));
        previousInput = tempResult.toString();
        currentInput = previousInput;
        currentOperator = op;
        waitingForOperand = true;
        updateDisplay();
      } else {
        previousInput = currentInput;
        currentOperator = op;
        waitingForOperand = true;
        updateDisplay();
      }
    } else {
      currentOperator = op;
      updateDisplay();
    }
  }

  // ============================================ */
  // БЛОК 17: Проценты
  // ============================================ */
  function percentage() {
    if (lastActionWasEqual) {
      clearAll();
    }
    let val = parseFloat(currentInput);
    if (isNaN(val)) return;
    let percentValue = val / 100;
    
    // Если есть предыдущий операнд, процент вычисляется относительно него
    if (previousInput !== null && currentOperator !== null && waitingForOperand === false) {
      let base = parseFloat(previousInput);
      if (!isNaN(base)) {
        percentValue = base * (val / 100);
      }
    }
    currentInput = percentValue.toString();
    waitingForOperand = false;
    updateDisplay();
  }

  // ============================================ */
  // БЛОК 18: Смена знака (+/-)
  // ============================================ */
  function toggleSign() {
    if (currentInput === 'Ошибка') return;
    let val = parseFloat(currentInput);
    if (isNaN(val)) return;
    val = -val;
    currentInput = val.toString();
    updateDisplay();
  }

  // ============================================ */
  // БЛОК 19: Очистка (AC и C)
  // ============================================ */
  function clearAll() {
    currentInput = '0';
    previousInput = null;
    currentOperator = null;
    waitingForOperand = false;
    lastActionWasEqual = false;
    updateDisplay();
  }

  function clearEntry() {
    if (currentInput !== '0' && currentInput.length > 1 && currentInput !== 'Ошибка') {
      currentInput = currentInput.slice(0, -1);
      if (currentInput === '' || currentInput === '-') currentInput = '0';
    } else {
      currentInput = '0';
    }
    waitingForOperand = false;
    lastActionWasEqual = false;
    updateDisplay();
  }

  // ============================================ */
  // БЛОК 20: Равно (=)
  // ============================================ */
  function equals() {
    if (currentInput === 'Ошибка') {
      return;
    }
    if (currentOperator !== null && previousInput !== null && !waitingForOperand) {
      calculateResult();
    } else if (currentOperator !== null && previousInput !== null && waitingForOperand) {
      currentInput = previousInput;
      previousInput = null;
      currentOperator = null;
      waitingForOperand = false;
      lastActionWasEqual = true;
      updateDisplay();
    } else {
      lastActionWasEqual = true;
      updateDisplay();
    }
  }

  // ============================================ */
  // БЛОК 21: Создание интерфейса кнопок
  // ============================================ */
  function buildButtons() {
    const buttonsConfig = [
      // Первая строка
      { text: 'AC', type: 'clear-all', action: 'clearAll', class: 'btn-clear' },
      { text: '+/−', type: 'sign', action: 'toggleSign', class: 'btn-function' },
      { text: '%', type: 'percent', action: 'percentage', class: 'btn-function' },
      { text: '÷', type: 'operator', action: 'divide', class: 'btn-operator', value: '/' },
      // Вторая строка
      { text: '7', type: 'digit', value: '7', class: '' },
      { text: '8', type: 'digit', value: '8', class: '' },
      { text: '9', type: 'digit', value: '9', class: '' },
      { text: '×', type: 'operator', action: 'multiply', class: 'btn-operator', value: '*' },
      // Третья строка
      { text: '4', type: 'digit', value: '4', class: '' },
      { text: '5', type: 'digit', value: '5', class: '' },
      { text: '6', type: 'digit', value: '6', class: '' },
      { text: '-', type: 'operator', action: 'subtract', class: 'btn-operator', value: '-' },
      // Четвертая строка
      { text: '1', type: 'digit', value: '1', class: '' },
      { text: '2', type: 'digit', value: '2', class: '' },
      { text: '3', type: 'digit', value: '3', class: '' },
      { text: '+', type: 'operator', action: 'add', class: 'btn-operator', value: '+' },
      // Пятая строка
      { text: '0', type: 'digit', value: '0', class: 'btn-zero' },
      { text: ',', type: 'decimal', action: 'decimal', class: '' },
      { text: '=', type: 'equals', action: 'equals', class: 'btn-equals' },
    ];

    const container = document.getElementById('buttons-container');
    container.innerHTML = '';
    
    buttonsConfig.forEach(btn => {
      const button = document.createElement('button');
      button.innerText = btn.text;
      
      // Формируем классы кнопки
      let baseClass = 'btn';
      if (btn.class) baseClass += ' ' + btn.class;
      if (btn.type === 'operator') baseClass += ' btn-operator';
      if (btn.type === 'equals') baseClass += ' btn-equals';
      if (btn.type === 'digit' && btn.text === '0') baseClass += ' btn-zero';
      if (btn.type === 'decimal') baseClass += ' btn-function';
      if (btn.type === 'percent') baseClass += ' btn-function';
      if (btn.type === 'sign') baseClass += ' btn-function';
      if (btn.type === 'clear-all') baseClass += ' btn-clear';
      button.className = baseClass;

      // Назначаем обработчики в зависимости от типа кнопки
      if (btn.type === 'digit') {
        button.addEventListener('click', () => inputDigit(btn.value));
      } else if (btn.type === 'decimal') {
        button.addEventListener('click', () => inputDecimal());
      } else if (btn.type === 'operator') {
        button.addEventListener('click', () => handleOperator(btn.value));
      } else if (btn.type === 'equals') {
        button.addEventListener('click', () => equals());
      } else if (btn.type === 'percent') {
        button.addEventListener('click', () => percentage());
      } else if (btn.type === 'sign') {
        button.addEventListener('click', () => toggleSign());
      } else if (btn.type === 'clear-all') {
        button.addEventListener('click', () => {
          // Умная очистка: если есть ввод — стираем символ, иначе полный сброс
          if (currentInput !== '0' && currentInput !== 'Ошибка' && waitingForOperand === false && lastActionWasEqual === false) {
            clearEntry();
          } else {
            clearAll();
          }
        });
      }
      container.appendChild(button);
    });
  }

  // ============================================ */
  // БЛОК 22: Инициализация приложения
  // ============================================ */
  function init() {
    buildButtons();    // Создаем все кнопки
    updateDisplay();   // Показываем начальное состояние (0)
  }

  init(); // Запуск калькулятора
</script>
</body>
</html>
